# ─── Convex ──────────────────────────────────────────────
# Auto-populated when you run `npx convex dev` for the first time.
NEXT_PUBLIC_CONVEX_URL=

# ─── Clerk ───────────────────────────────────────────────
# From https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Frontend API URL — set as a Convex env var (NOT in this file):
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN <value>
# Get the value from https://dashboard.clerk.com/apps/setup/convex

# ─── AI providers ────────────────────────────────────────
# OpenRouter (https://openrouter.ai/keys) — used via Vercel AI SDK gateway pattern.
OPENROUTER_API_KEY=

# ─── Retrieval ───────────────────────────────────────────
# Exa (https://dashboard.exa.ai/api-keys) — career data, role lookups, web search.
EXA_API_KEY=
