# ─── Convex ──────────────────────────────────────────────
# Auto-populated when you run `npx convex dev` for the first time.
NEXT_PUBLIC_CONVEX_URL=

# ─── Clerk ───────────────────────────────────────────────
# From https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local sign-in / sign-up routes (overrides Clerk's hosted Account Portal).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/profile
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/profile

# Clerk Frontend API URL — set as a Convex env var (NOT in this file):
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN <value>
# Get the value from https://dashboard.clerk.com/apps/setup/convex

# ─── AI providers ────────────────────────────────────────
# OpenRouter (https://openrouter.ai/keys) — used via Vercel AI SDK gateway pattern.
OPENROUTER_API_KEY=

# ─── Retrieval ───────────────────────────────────────────
# Exa (https://dashboard.exa.ai/api-keys) — career data, role lookups, web search.
EXA_API_KEY=

# ─── Site URL ────────────────────────────────────────────
# Public canonical origin used for metadataBase, canonical URLs, OG/Twitter
# absolute image URLs, and the sitemap reference in /robots.txt. Falls back
# to http://localhost:3000 when unset (suitable for local dev).
NEXT_PUBLIC_SITE_URL=https://career-steer.com

# ─── Brandfetch ──────────────────────────────────────────
# Logo Link client ID. Brandfetch's CDN now requires `?c={clientId}` on every
# hotlinked request — without it, the CDN 302s to their docs and the <img>
# breaks. The ID is non-sensitive by Brandfetch's own design (meant to ship
# in browser HTML), so we expose the same value twice: server-only for the
# Brand Search API + server-side URL helper, NEXT_PUBLIC_* for client-side
# CDN URL minting in <CompanyMark> / <JobCardRow>.
BRANDFETCH_CLIENT_ID=
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=
